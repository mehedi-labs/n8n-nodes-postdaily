{
  "name": "n8n-nodes-postdaily",
  "version": "0.1.0",
  "description": "n8n node for PostDaily: draft, queue and schedule social media posts to Instagram, Facebook, TikTok, YouTube, LinkedIn, X, Threads, Pinterest, Bluesky and Mastodon.",
  "license": "MIT",
  "homepage": "https://www.postdaily.app/help/connect-with-an-api-key",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "postdaily",
    "social media",
    "scheduling",
    "instagram",
    "tiktok",
    "linkedin"
  ],
  "author": {
    "name": "mehedihasan2810",
    "email": "117534561+mehedihasan2810@users.noreply.github.com",
    "url": "https://github.com/mehedihasan2810"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehedi-labs/n8n-nodes-postdaily.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PostDailyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PostDaily/PostDaily.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/mehedi-labs/n8n-nodes-postdaily/issues"
  }
}
